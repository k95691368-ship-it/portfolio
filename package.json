{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:api && npm run build:retention",
    "build:api": "node scripts/generate-supabase-routes.mjs && esbuild supabase/functions/api/index.ts --bundle --format=esm --platform=neutral --target=es2022 --external:npm:postgres@3.4.7 --outfile=.tmp-supabase-edge-index.js",
    "build:retention": "esbuild supabase/functions/retention/index.ts --bundle --format=esm --platform=neutral --target=es2022 --external:npm:postgres@3.4.7 --outfile=.tmp-supabase-retention.js",
    "lint": "oxlint",
    "test": "vitest run --exclude tests/smoke.test.js --exclude tests/e2e.test.js",
    "smoke": "vitest run tests/smoke.test.js",
    "e2e": "vitest run tests/e2e.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@sun-typeface/suit": "2.0.5",
    "@supabase/supabase-js": "^2.57.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "signature_pad": "^5.1.3",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1"
  }
}
