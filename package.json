{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "wrangler pages dev -- npm run dev",
    "build": "vite build && npm run build:functions",
    "//build:functions": "vite build는 프론트엔드만 본다. 서버 코드(functions/)의 import 오류는 Cloudflare에 올라간 뒤에야 드러나 배포가 통째로 실패한다. 실제로 그렇게 한 번 실패했다. 참고: Windows에서 wrangler가 컴파일 성공 후 종료 과정에서 간헐적으로 비정상 코드를 반환한다 - 'Compiled Worker successfully'가 찍혔다면 성공이다. 최종 판정은 배포 상태(wrangler pages deployment list)로 한다.",
    "build:functions": "wrangler pages functions build --outdir=.functions-build",
    "lint": "oxlint",
    "test": "vitest run --exclude tests/smoke.test.js --exclude tests/e2e.test.js",
    "smoke": "vitest run tests/smoke.test.js",
    "e2e": "vitest run tests/e2e.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@cloudflare/realtimekit-react": "^2.0.2",
    "@cloudflare/realtimekit-react-ui": "^2.0.2",
    "@cloudflare/realtimekit-ui": "^2.0.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "pretendard": "1.3.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "signature_pad": "^5.1.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "vitest": "^3.2.7",
    "wrangler": "^4.112.0"
  }
}
